{
  "name": "@annex/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec wrangler dev --experimental-new-config --port 8787 --persist-to ../../.wrangler/state",
    "migrate": "cf d1 migrations apply 267490be-7141-4d00-ab23-152742f2f6ef --local --persist-to ../../.wrangler/state",
    "build": "tsc",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.2",
    "lib0": "^0.2.0",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^22.0.0",
    "cf": "1.0.0-beta.26",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.156.0"
  }
}
