{
  "name": "@annex/admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"cd frontend && pnpm dev\" \"pnpm exec wrangler dev --experimental-new-config --port 8789 --persist-to ../../.wrangler/state\"",
    "build": "cd frontend && pnpm build",
    "deploy": "pnpm build && cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "hono": "^4.12.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@types/node": "^22.19.15",
    "cf": "1.0.0-beta.26",
    "concurrently": "^9.2.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.156.0"
  }
}
